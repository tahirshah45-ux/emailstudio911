# ── Storage ────────────────────────────────────────────────────────
# Production storage is Firebase Firestore (the only source of truth).
# STORAGE_DRIVER=json switches to local JSON files for offline
# development / CI smoke tests ONLY. Default: firestore.
# STORAGE_DRIVER=firestore

# Firebase web config (defaults to the official client-communication-center
# project — override only if you move to a different Firebase project).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_DATABASE_ID=emailsystem911makers

# Only used when STORAGE_DRIVER=json:
# DATA_DIR=./data

# ── SMTP transport (credentials live here, NEVER in the database) ──
# SMTP_PROVIDER: gmail | microsoft | custom
SMTP_PROVIDER=gmail

# Credentials (for Gmail use an App Password: Google Account → Security → App Passwords)
SMTP_USER=you@example.com
SMTP_PASS=your-app-password

# Fallback sender identity — the Settings page in the app takes precedence.
SMTP_FROM_NAME=911 Makers
SMTP_FROM_EMAIL=you@example.com
# SMTP_REPLY_TO=support@911makers.com

# Only required when SMTP_PROVIDER=custom
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=false
