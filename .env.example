# ── Firebase Admin (REQUIRED for server → Firestore access) ────────
# Service-account key JSON, base64-encoded (recommended) or raw on one
# line. Generate: Firebase Console → Project settings → Service accounts
# → Generate new private key. Full instructions: FIRESTORE_SETUP.md
FIREBASE_SERVICE_ACCOUNT_KEY=
# Alternative: path to the key file instead of the variable above
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccountKey.json

# ── Storage ────────────────────────────────────────────────────────
# Production storage is Firebase Firestore (the only source of truth).
# STORAGE_DRIVER=json switches to local JSON files for offline
# development / CI smoke tests ONLY. Default: firestore.
# STORAGE_DRIVER=firestore

# Firebase web config (defaults to the official client-communication-center
# project — override only if you move to a different Firebase project).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_DATABASE_ID=emailsystem911makers

# Only used when STORAGE_DRIVER=json:
# DATA_DIR=./data

# ── Cloudinary (client portal file uploads) ────────────────────────
# Dashboard → Settings → API Keys. The secret stays server-side; uploads
# use short-lived signatures minted by the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional root folder for uploads (default: 911-makers-ccc)
# CLOUDINARY_FOLDER=911-makers-ccc
# Optional per-file size limit shown/enforced in the portal (default 25)
# NEXT_PUBLIC_MAX_UPLOAD_MB=25

# ── Resend transport (credentials live here, NEVER in the database) ──
# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Fallback sender identity — the Settings page in the app takes precedence.
# Must be a verified domain/sender in Resend.
EMAIL_FROM=911 Makers <project@911makers.com>
# EMAIL_REPLY_TO=support@911makers.com
